# =============================================================================
# Dolci Rêva Web — PRODUCTION (PM2 / VPS)
# Domaine unique : https://dolci-reva.com
# =============================================================================

# Browser → BFF Next (cookie httpOnly)
NEXT_PUBLIC_API_URL=/api/backend/

# Upstream Laravel en local sur le VPS (évite boucle Nginx)
# Docker nginx API écoute 127.0.0.1:8080
LARAVEL_API_URL=http://127.0.0.1:8080/api/

# Médias / next/image — même domaine public
NEXT_PUBLIC_API_HOSTNAME=dolci-reva.com

NODE_ENV=production
