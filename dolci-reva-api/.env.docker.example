# =============================================================================
# Dolci Rêva API — PRODUCTION (Docker Compose VPS)
# Domaine unique : https://dolci-reva.com  (pas de sous-domaine api.)
# -----------------------------------------------------------------------------
#   cp .env.docker.example .env
#   nano .env
#   docker compose exec php php artisan key:generate
# =============================================================================

APP_NAME="Dolci Rêva"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dolci-reva.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Front / CORS / Sanctum — même domaine
# -----------------------------------------------------------------------------
FRONTEND_URL=https://dolci-reva.com
SANCTUM_STATEFUL_DOMAINS=dolci-reva.com,www.dolci-reva.com

# -----------------------------------------------------------------------------
# MySQL (host = service Docker)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dolci_reva
DB_USERNAME=dolci_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.dolci-reva.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DISK=public

# -----------------------------------------------------------------------------
# Booking / Avoir (optionnels)
# -----------------------------------------------------------------------------
BOOKING_UNPAID_HOLD_MINUTES=30
BOOKING_CANCEL_RESIDENCE_HOURS=48
BOOKING_CANCEL_RESTAURANT_HOURS=4

# -----------------------------------------------------------------------------
# Paystack LIVE
# Webhook :
#   https://dolci-reva.com/api/payments/webhook
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=CHANGE_ME@example.com
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_TRANSFERS_ENABLED=true
PAYSTACK_CODE_WAVE=WAVE
PAYSTACK_CODE_ORANGE=ORANGE
PAYSTACK_CODE_MTN=MTN
PAYSTACK_CODE_MOOV=MOOV
PAYOUT_CURRENCY=XOF

# -----------------------------------------------------------------------------
# WhatsApp (optionnel)
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_URL=https://graph.facebook.com

# -----------------------------------------------------------------------------
# Email SMTP
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# Hostinger SMTP (mail.dolci-reva.com has no A record — use smtp.hostinger.com)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@dolci-reva.com
MAIL_PASSWORD='N$VEu6nv@2'
MAIL_FROM_ADDRESS="noreply@dolci-reva.com"
MAIL_FROM_NAME="Dolci Rêva"

# -----------------------------------------------------------------------------
# S3 optionnel
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
