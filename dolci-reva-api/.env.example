APP_NAME="Dolci Rêva"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dolci-reva.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================================
# BASE DE DONNÉES (MySQL en production)
# ===========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dolci_reva
DB_USERNAME=dolci_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

# ===========================================================
# CORS / Frontend (web)
# ===========================================================
FRONTEND_URL=https://dolci-reva.com

# ===========================================================
# SANCTUM - Domaines autorisés (auth cookie SPA si utilisé)
# ===========================================================
SANCTUM_STATEFUL_DOMAINS=dolci-reva.com,www.dolci-reva.com

# ===========================================================
# PAYSTACK (LIVE en production) — dashboard.paystack.com
# ===========================================================
# LIVE uniquement en prod : sk_live_… / pk_live_…
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=
# Signature webhook : laisser vide pour utiliser PAYSTACK_SECRET_KEY (HMAC)
PAYSTACK_WEBHOOK_SECRET=
# Webhook à configurer côté Paystack :
#   https://dolci-reva.com/api/payments/webhook
PAYSTACK_TRANSFERS_ENABLED=true
PAYSTACK_CODE_WAVE=WAVE
PAYSTACK_CODE_ORANGE=ORANGE
PAYSTACK_CODE_MTN=MTN
PAYSTACK_CODE_MOOV=MOOV
PAYOUT_CURRENCY=XOF

# ===========================================================
# BOOKING / AVOIR (optionnel — defaults dans config/booking.php)
# ===========================================================
# BOOKING_CREDIT_ENABLED=true
# BOOKING_CREDIT_BONUS_PERCENT=10
# BOOKING_CREDIT_EXPIRES_MONTHS=12

# ===========================================================
# WHATSAPP BUSINESS API (Meta Cloud API)
# ===========================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_URL=https://graph.facebook.com

# ===========================================================
# EMAIL
# ===========================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# Hostinger SMTP (mail.dolci-reva.com has no A record — use smtp.hostinger.com)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@dolci-reva.com
# Guillemets simples si le mot de passe contient $ (sinon dotenv l'interprète)
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@dolci-reva.com"
MAIL_FROM_NAME="Dolci Rêva"

# ===========================================================
# STOCKAGE MEDIA
# ===========================================================
MEDIA_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
