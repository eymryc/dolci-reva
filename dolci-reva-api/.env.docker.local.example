# =============================================================================
# Dolci Rêva API — environnement Docker LOCAL
# cp .env.docker.local.example .env
# =============================================================================

APP_NAME="Dolci Rêva"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000

# Hosts = noms des services docker compose
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dolci_reva
DB_USERNAME=dolci_user
DB_PASSWORD=dolci_secret
MYSQL_ROOT_PASSWORD=root_secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Local / Docker local — pas de vrai SMTP (log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dolci-reva.com"
MAIL_FROM_NAME="Dolci Rêva"

FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# Paystack test (optionnel en local)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_TRANSFERS_ENABLED=false
PAYOUT_CURRENCY=XOF
