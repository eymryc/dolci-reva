# =============================================================================
# Dolci Rêva — configuration déploiement maison (PAS GitHub Actions)
# Copier vers deploy.env et ajuster :
#   cp deploy/config/deploy.env.example deploy/config/deploy.env
# =============================================================================

# remote = SSH vers le VPS puis exécute les scripts
# local  = exécute directement sur cette machine (chemin DEPLOY_PATH)
DEPLOY_MODE=remote

# --- SSH (mode remote) -------------------------------------------------------
DEPLOY_HOST=votre.vps.ip.ou.domaine
# Debian cloud → debian | Ubuntu cloud → ubuntu | sinon root
DEPLOY_USER=debian
DEPLOY_SSH_PORT=22
# Vide = mot de passe / agent. Sinon chemin clé privée (+ IdentitiesOnly).
DEPLOY_SSH_KEY=

# Racine monorepo sur le VPS
DEPLOY_PATH=/opt/dolci-reva

# Git
GIT_REMOTE=origin
GIT_BRANCH=main

# Flags déploiement (0|1)
SKIP_PULL=0
SKIP_MIGRATE=0
# 1 = docker compose up sans rebuild images
SKIP_BUILD_IMAGES=0

# Docker / PM2
DOCKER_COMPOSE_FILE=docker-compose.yml
PM2_APP_NAME=dolci-front
# :3000 déjà pris par folioas-web sur ce VPS
WEB_PORT=3001

# Healthchecks post-deploy
HEALTH_URL=https://dolci-reva.com/up
WEB_HEALTH_URL=https://dolci-reva.com/

# Let's Encrypt / Certbot (./deploy/bin/dolci ssl)
DOMAIN=dolci-reva.com
DOMAIN_WWW=www.dolci-reva.com
CERTBOT_EMAIL=noreply@dolci-reva.com
